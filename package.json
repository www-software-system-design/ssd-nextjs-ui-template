{
  "name": "nextjs-ui-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "check:commit": "node scripts/check-commit-message.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "node scripts/check-architecture.ts",
    "generate:feature": "node scripts/generate-feature.ts",
    "test:tooling": "node --test scripts/*.test.ts",
    "test:features": "node --conditions=react-server --test src/features/*/*.test.ts",
    "test:state": "node --test src/lib/stores/*.test.ts src/config/theme.test.ts",
    "test": "npm run test:tooling && npm run test:features && npm run test:state",
    "check": "npm run format:check && npm run lint && npm run check:architecture && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "dependencies": {
    "@orpc/client": "1.16.1",
    "@orpc/server": "1.16.1",
    "@software-system.design/ui": "0.3.0",
    "@standard-schema/spec": "1.1.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "husky": "9.1.7",
    "prettier": "3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "8.71.1"
  }
}
